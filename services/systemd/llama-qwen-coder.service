# LocalAI-Lab Qwen3-Coder Q3 daily-use profile (2026-10-08)
# Source of truth for the documented template; not automatically deployed.
# Install a private EnvironmentFile before starting; see docs/agents/.
[Unit]
Description=LocalAI-Lab Qwen3-Coder 30B Q3 llama-server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=jpdeleon
WorkingDirectory=/home/jpdeleon/llama.cpp
Environment="LD_LIBRARY_PATH=/opt/rocm/core-10.0/lib"
EnvironmentFile=/etc/localai/llama-qwen-coder.env
ExecStart=/home/jpdeleon/llama.cpp/build-rocm/bin/llama-server \
  -m /srv/models/coding/qwen3-coder-30b-a3b/Qwen3-Coder-30B-A3B-Instruct-Q3_K_M.gguf \
  --host 0.0.0.0 \
  --port 8080 \
  --alias qwen3-coder \
  --fit on \
  --fit-target 1024 \
  -c 114688 \
  -np 1 \
  --jinja \
  --metrics \
  --temp 0.7 \
  --top-p 0.8 \
  --top-k 20 \
  --repeat-penalty 1.05 \
  --api-key ${LOCALAI_API_KEY}
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
